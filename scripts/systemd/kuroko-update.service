# Installs new crates.io releases on the server that runs the web portal (docs/delivery.md).
# Install: copy scripts/vps-update.py to ~/.local/bin/kuroko-update (0755) and
# this unit and its timer to ~/.config/systemd/user/, then
# `systemctl --user daemon-reload && systemctl --user enable --now kuroko-update.timer`.
[Unit]
Description=Kuroko: install a new crates.io release on this server
Documentation=https://github.com/elvisbrevi/kuroko/blob/main/docs/delivery.md

[Service]
Type=oneshot
Environment=PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h
ExecStart=/usr/bin/python3 -I %h/.local/bin/kuroko-update
# A release build next to the production portal: keep it in the background.
Nice=10
CPUWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Above this the build is slowed down and swapped rather than letting it crowd out the portal.
MemoryHigh=3G
TimeoutStartSec=75min
UMask=0077
NoNewPrivileges=true
